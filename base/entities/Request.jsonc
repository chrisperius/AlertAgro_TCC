{
  "name": "Request",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": ["Entrada", "Saida"],
      "title": "Tipo de Solicita\u00e7\u00e3o",
    },
    "usuario_id": {
      "type": "string",
      "title": "ID do Solicitante",
    },
    "usuario_nome": {
      "type": "string",
      "title": "Nome do Solicitante",
    },
    "produtos_lista": {
      "type": "array",
      "title": "Lista de Produtos",
      "items": {
        "type": "object",
        "properties": {
          "produto_id": {
            "type": "string",
          },
          "produto_nome": {
            "type": "string",
          },
          "quantidade": {
            "type": "number",
          },
        },
      },
    },
    "finalidade": {
      "type": "string",
      "title": "Finalidade",
    },
    "status": {
      "type": "string",
      "enum": ["Pendente", "Aprovado", "Recusado"],
      "title": "Status",
      "default": "Pendente",
    },
    "data_solicitacao": {
      "type": "string",
      "format": "date",
      "title": "Data da Solicita\u00e7\u00e3o",
    },
    "data_resposta": {
      "type": "string",
      "format": "date",
      "title": "Data da Resposta",
    },
    "resposta_observacao": {
      "type": "string",
      "title": "Observa\u00e7\u00e3o da Resposta",
    },
  },
  "required": [
    "tipo",
    "usuario_nome",
    "produtos_lista",
    "status",
    "data_solicitacao",
  ],
}
